# DriveX environment variables
# Copy the appropriate values into backend/.env, frontend/.env, and admin/.env as needed.

# Backend environment
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/drivex?retryWrites=true&w=majority
JWT_SECRET=supersecretjwtkey
JWT_REFRESH_SECRET=supersecretrefreshkey
FRONTEND_URL=http://localhost:4173
ADMIN_URL=http://localhost:5174
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloud-key
CLOUDINARY_API_SECRET=your-cloud-secret
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Frontend environment
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=your-razorpay-key

# Admin environment
VITE_ADMIN_API_URL=http://localhost:5000/api/secure-admin-panel
